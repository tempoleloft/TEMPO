generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String?
  emailVerified       DateTime?
  role                Role                 @default(CLIENT)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  image               String?
  name                String?
  blacklistReason     String?
  blacklistedAt       DateTime?
  isBlacklisted       Boolean              @default(false)
  lastLogin           DateTime?
  accounts            Account[]
  sessions            AuthSession[]
  clientProfile       ClientProfile?
  creditLedger        CreditLedger[]
  memberships         Membership[]
  passwordResetTokens PasswordResetToken[]
  purchases           Purchase[]
  reservations        Reservation[]
  sessionsCreated     Session[]            @relation("CreatedBy")
  teacherProfile      TeacherProfile?
  waitlistEntries     WaitlistEntry[]
  WalkInParticipant   WalkInParticipant[]
  wallet              Wallet?

  @@index([email])
  @@index([role])
}

model ClientProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  firstName        String
  lastName         String
  phone            String
  birthdate        DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  newsletterOptOut Boolean   @default(false)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  displayName String
  bio         String?
  photoUrl    String?
  specialties String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isActive    Boolean   @default(true)
  sessions    Session[]
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model AuthSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model WaitlistEntry {
  id         String         @id @default(cuid())
  sessionId  String
  userId     String
  position   Int
  status     WaitlistStatus @default(WAITING)
  token      String?        @unique
  notifiedAt DateTime?
  expiresAt  DateTime?
  acceptedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  session    Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId, status])
  @@index([status, expiresAt])
}

model ClassType {
  id          String    @id @default(cuid())
  title       String
  description String?
  durationMin Int       @default(60)
  level       String?
  colorTag    String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sessions    Session[]

  @@index([active])
}

model Session {
  id                 String              @id @default(cuid())
  classTypeId        String
  teacherId          String
  startAt            DateTime
  endAt              DateTime
  capacity           Int                 @default(12)
  location           String?
  status             SessionStatus       @default(SCHEDULED)
  notes              String?
  createdById        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  level              String?
  reservations       Reservation[]
  classType          ClassType           @relation(fields: [classTypeId], references: [id])
  createdBy          User?               @relation("CreatedBy", fields: [createdById], references: [id])
  teacher            TeacherProfile      @relation(fields: [teacherId], references: [id])
  waitlist           WaitlistEntry[]
  walkInParticipants WalkInParticipant[]

  @@index([startAt])
  @@index([teacherId])
  @@index([status])
  @@index([classTypeId, startAt])
}

model Reservation {
  id                        String             @id @default(cuid())
  sessionId                 String
  userId                    String
  status                    ReservationStatus  @default(BOOKED)
  bookedAt                  DateTime           @default(now())
  cancelledAt               DateTime?
  cancellationPolicyApplied Boolean            @default(false)
  creditLedgerId            String?            @unique
  attendedAt                DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  guestReservations         GuestReservation[]
  creditLedger              CreditLedger?      @relation(fields: [creditLedgerId], references: [id])
  session                   Session            @relation(fields: [sessionId], references: [id])
  user                      User               @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
  @@index([userId])
  @@index([sessionId])
  @@index([status])
}

model GuestReservation {
  id             String        @id @default(cuid())
  reservationId  String
  guestFirstName String
  guestLastName  String
  creditLedgerId String?       @unique
  createdAt      DateTime      @default(now())
  guestEmail     String?
  creditLedger   CreditLedger? @relation(fields: [creditLedgerId], references: [id])
  reservation    Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
}

model Product {
  id            String      @id @default(cuid())
  name          String
  description   String?
  kind          ProductKind
  credits       Int         @default(0)
  priceCents    Int
  currency      String      @default("EUR")
  stripePriceId String?     @unique
  validityDays  Int?
  active        Boolean     @default(true)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  imageUrl      String?
  featured      Boolean     @default(false)
  isHidden      Boolean     @default(false)
  unlockCode    String?
  purchases     Purchase[]

  @@index([active])
  @@index([kind])
}

model Purchase {
  id                      String         @id @default(cuid())
  userId                  String
  productId               String
  stripeCheckoutSessionId String?        @unique
  stripePaymentIntentId   String?
  amountCents             Int
  currency                String         @default("EUR")
  status                  PurchaseStatus @default(PENDING)
  creditsGranted          Int            @default(0)
  expiresAt               DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  product                 Product        @relation(fields: [productId], references: [id])
  user                    User           @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([stripeCheckoutSessionId])
}

model Wallet {
  id             String   @id @default(cuid())
  userId         String   @unique
  creditsBalance Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditLedger {
  id               String            @id @default(cuid())
  userId           String
  delta            Int
  reason           CreditReason
  refType          String?
  refId            String?
  notes            String?
  createdAt        DateTime          @default(now())
  user             User              @relation(fields: [userId], references: [id])
  guestReservation GuestReservation?
  reservation      Reservation?

  @@index([userId])
  @@index([createdAt])
  @@index([refType, refId])
}

model Settings {
  id                  String   @id @default("default")
  cancelHoursBefore   Int      @default(12)
  maxWaitlistSize     Int      @default(3)
  defaultCapacity     Int      @default(12)
  reminderEnabled     Boolean  @default(false)
  reminderHoursBefore Int      @default(24)
  updatedAt           DateTime @updatedAt
}

model CafeMenuItem {
  id          String   @id @default(cuid())
  name        String
  price       Decimal  @db.Decimal(10, 2)
  description String?
  category    String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imageUrl    String?

  @@index([category])
  @@index([isActive])
}

model MembershipPlan {
  id                 String                @id @default(cuid())
  name               String
  description        String?
  creditsPerMonth    Int
  priceCentsPerMonth Int
  commitmentMonths   Int
  renewalType        MembershipRenewalType
  promoFreeMonths    Int?
  promoBonusCredits  Int?
  stripePriceId      String?               @unique
  stripeProductId    String?
  isActive           Boolean               @default(true)
  sortOrder          Int                   @default(0)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  memberships        Membership[]

  @@index([isActive])
}

model Membership {
  id                   String           @id @default(cuid())
  userId               String
  planId               String
  startDate            DateTime
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  commitmentEndDate    DateTime
  creditsExpiryDate    DateTime
  status               MembershipStatus @default(ACTIVE)
  cancelledAt          DateTime?
  cancelAtPeriodEnd    Boolean          @default(false)
  stripeSubscriptionId String?          @unique
  stripeCustomerId     String?
  totalCreditsGranted  Int              @default(0)
  monthsCompleted      Int              @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  plan                 MembershipPlan   @relation(fields: [planId], references: [id])
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([stripeSubscriptionId])
}

model WalkInParticipant {
  id                String            @id @default(cuid())
  sessionId         String
  firstName         String
  lastName          String
  email             String?
  phone             String?
  source            AcquisitionSource @default(WALK_IN)
  notes             String?
  status            ReservationStatus @default(BOOKED)
  attendedAt        DateTime?
  createdAt         DateTime          @default(now())
  createdById       String?
  numeroReservation String?
  User              User?             @relation(fields: [createdById], references: [id])
  session           Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([source, numeroReservation])
}

enum Role {
  CLIENT
  TEACHER
  ADMIN
}

enum SessionStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum ReservationStatus {
  BOOKED
  CANCELLED
  NO_SHOW
  ATTENDED
}

enum ProductKind {
  SINGLE
  PACK
  MERCH
}

enum PurchaseStatus {
  PENDING
  PAID
  REFUNDED
}

enum CreditReason {
  PURCHASE
  BOOKING
  CANCEL_REFUND
  ADMIN_ADJUST
  EXPIRATION
  MEMBERSHIP
}

enum MembershipRenewalType {
  AUTO
  FIXED
}

enum MembershipStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAUSED
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum AcquisitionSource {
  WALK_IN
  INSTAGRAM
  GOOGLE
  WORD_OF_MOUTH
  FLYER
  PARTNERSHIP
  EVENT
  OTHER
  CLASSPASS
  GYMLIB
  LASTSPOT
}
